{
  "name": "brix",
  "version": "0.1.0",
  "description": "Brix build authoring in TypeScript — the Python API, transliterated (docs/boundary-schema.md).",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist/", "native/brix_node.node"],
  "scripts": {
    "build:native": "cargo build --release -p brix-node && node -e \"require('fs').copyFileSync(require('path').join('..','rust','target','release','libbrix_node.so'),'native/brix_node.node')\"",
    "build:native:debug": "cargo build -p brix-node && node -e \"require('fs').copyFileSync(require('path').join('..','rust','target','debug','libbrix_node.so'),'native/brix_node.node')\"",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:native && npm run build:ts",
    "test": "npm run build:native:debug && npm run build:ts && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
}
